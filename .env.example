# Provider API keys for CLI use (env wins over secrets.json).
# These names are read by createEnvSecretsStore in @imagent/config.

# OpenAI
OPENAI_API_KEY=

# Azure Foundry (covers Azure OpenAI / MAI Image / FLUX families on one resource).
AZURE_API_KEY=
AZURE_ENDPOINT=

# Google (Imagen / Gemini)
GOOGLE_API_KEY=

# Flux (BFL official)
FLUX_BFL_API_KEY=

# ByteDance (shared by Seedream image + Seedance video).
# Both vars are required — endpoint encodes the region in its URL.
BYTEDANCE_API_KEY=
BYTEDANCE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
