# Provider API keys for CLI use (env wins over secrets.json).
# These names are read by createEnvSecretsStore in @imagine/config.

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Google (Imagen / Gemini)
GOOGLE_API_KEY=

# Flux (BFL official)
FLUX_BFL_API_KEY=

# ByteDance (shared by Seedream image + Seedance video).
# Both vars are required — endpoint encodes the region in its URL.
BYTEDANCE_API_KEY=
BYTEDANCE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
