# Provider API keys for CLI use (env wins over secrets.json).
# These names are read by createEnvSecretsStore in @imagine-studio/config.

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Google (Imagen / Gemini)
GOOGLE_API_KEY=

# Flux (BFL official)
FLUX_BFL_API_KEY=

# Volcengine (shared by Seedream image + Seedance video)
VOLCENGINE_API_KEY=
VOLCENGINE_REGION=cn-beijing
