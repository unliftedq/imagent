{
  "name": "@imagent/providers",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"require('node:fs').cpSync('src/catalog.default.json','dist/catalog.default.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/xai": "catalog:",
    "@elevenlabs/elevenlabs-js": "catalog:",
    "@google/genai": "catalog:",
    "@imagent/config": "workspace:*",
    "@imagent/core": "workspace:*",
    "ai": "catalog:",
    "openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
