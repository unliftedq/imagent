{
  "name": "@imagent/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && bun run copy-sql",
    "copy-sql": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','migrations');const dst=path.join('dist','migrations');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src))fs.copyFileSync(path.join(src,f),path.join(dst,f));\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@imagent/core": "workspace:*",
    "better-sqlite3": "catalog:",
    "ffmpeg-static": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
