{
  "name": "@imagent/cli",
  "version": "0.1.0",
  "description": "Local-first image and video generation CLI for imagent.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/unliftedq/imagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unliftedq/imagent.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/unliftedq/imagent/issues"
  },
  "keywords": [
    "generative-ai",
    "generative-art",
    "image-generation",
    "video-generation"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "imagent": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-js.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "bun run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "build:binary": "tsc -b && node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@ai-sdk/bytedance": "catalog:",
    "@ai-sdk/xai": "catalog:",
    "@google/genai": "catalog:",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "ffmpeg-static": "catalog:",
    "openai": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@imagent/config": "workspace:*",
    "@imagent/core": "workspace:*",
    "@imagent/persistence": "workspace:*",
    "@imagent/providers": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "postject": "catalog:",
    "vitest": "catalog:"
  }
}
