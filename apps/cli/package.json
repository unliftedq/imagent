{
  "name": "@imagent/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "imagent": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "tsc -b && node dist/index.js",
    "start": "node dist/index.js",
    "build:binary": "tsc -b && node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@imagent/config": "workspace:*",
    "@imagent/core": "workspace:*",
    "@imagent/persistence": "workspace:*",
    "@imagent/providers": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^4.1.5"
  }
}
