{
  "name": "@imagine/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "imagine": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "tsc -b && node dist/index.js",
    "start": "node dist/index.js",
    "build:binary": "tsc -b && node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@imagine/config": "workspace:*",
    "@imagine/core": "workspace:*",
    "@imagine/persistence": "workspace:*",
    "@imagine/providers": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^3.0.0"
  }
}
