{
  "name": "@imagent/cli",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "imagent": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.d.ts",
    "dist/migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-js.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "bun run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "build:binary": "tsc -b && node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@ai-sdk/bytedance": "^2.0.0-beta.30",
    "@ai-sdk/xai": "^4.0.0-beta.46",
    "@google/genai": "^1.51.0",
    "ai": "^7.0.0-beta.113",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ffmpeg-static": "^5.3.0",
    "openai": "^6.35.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^4.1.5"
  }
}
